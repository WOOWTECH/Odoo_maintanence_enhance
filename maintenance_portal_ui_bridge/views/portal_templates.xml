<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Bridge: Replace dashboard SVG icons with FontAwesome
         (Portal UI style) when woow_portal_ui is installed.

         The portal home card (portal.portal_docs_entry) is already
         globally styled by woow_portal_ui CSS, so no XPath needed
         for that. This bridge handles the sub-dashboard cards.
         ============================================================ -->
    <template id="bridge_dashboard_icons"
              name="Bridge: Dashboard Icons to Portal UI style"
              inherit_id="maintenance_portal.portal_my_maintenance">

        <!-- Equipment card: SVG → FA (let woow_portal_ui handle the icon) -->
        <xpath expr="//t[@t-set='icon'][@t-value=&quot;'/maintenance_portal/static/src/img/equipment.svg'&quot;]" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Request card: SVG → FA -->
        <xpath expr="//t[@t-set='icon'][@t-value=&quot;'/maintenance_portal/static/src/img/maintenance_request.svg'&quot;]" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
    </template>

    <!-- Portal Home card: SVG → FA -->
    <template id="bridge_home_icon"
              name="Bridge: Home Card Icon to Portal UI style"
              inherit_id="maintenance_portal.portal_my_home_maintenance">
        <xpath expr="//t[@t-set='icon']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
    </template>

</odoo>
