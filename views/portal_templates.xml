<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== Portal Home Card ==================== -->

    <template id="portal_my_home_maintenance" name="Portal My Home: Maintenance" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/maintenance_portal/static/src/img/maintenance_dashboard.svg?v=2'"/>
                <t t-set="title">Maintenance</t>
                <t t-set="url" t-value="'/my/maintenance'"/>
                <t t-set="text">Manage equipment and maintenance requests</t>
                <t t-set="placeholder_count" t-value="'maintenance_count'"/>
            </t>
        </div>
    </template>

    <!-- ==================== Breadcrumbs ==================== -->

    <template id="portal_breadcrumbs_maintenance" name="Portal Breadcrumbs: Maintenance"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol" position="inside">
            <!-- Maintenance Dashboard -->
            <li t-if="page_name in ('maintenance', 'equipments', 'equipment_detail', 'maintenance_requests', 'maintenance_request_detail')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'maintenance' else ''}">
                <a t-if="page_name != 'maintenance'" href="/my/maintenance">Maintenance</a>
                <t t-else="">Maintenance</t>
            </li>
            <!-- Equipment list -->
            <li t-if="page_name in ('equipments', 'equipment_detail')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'equipments' else ''}">
                <a t-if="page_name != 'equipments'" href="/my/equipments">Equipment</a>
                <t t-else="">Equipment</t>
            </li>
            <!-- Equipment detail -->
            <li t-if="page_name == 'equipment_detail'" class="breadcrumb-item active">
                <t t-esc="equipment.name"/>
            </li>
            <!-- Request list -->
            <li t-if="page_name in ('maintenance_requests', 'maintenance_request_detail')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'maintenance_requests' else ''}">
                <a t-if="page_name != 'maintenance_requests'" href="/my/maintenance-requests">Requests</a>
                <t t-else="">Requests</t>
            </li>
            <!-- Request detail -->
            <li t-if="page_name == 'maintenance_request_detail'" class="breadcrumb-item active">
                <t t-esc="mrequest.name"/>
            </li>
        </xpath>
    </template>

    <!-- ==================== Maintenance Dashboard Page ==================== -->

    <template id="portal_my_maintenance" name="Maintenance Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="o_portal_my_home">
                <h3 class="page-header mt-3">Maintenance</h3>

                <div class="o_portal_category row g-2 mt-3">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/maintenance_portal/static/src/img/equipment.svg'"/>
                        <t t-set="title">My Equipment</t>
                        <t t-set="url" t-value="'/my/equipments'"/>
                        <t t-set="text">View your assigned maintenance equipment</t>
                        <t t-set="placeholder_count" t-value="'equipment_count'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/maintenance_portal/static/src/img/maintenance_request.svg'"/>
                        <t t-set="title">Maintenance Requests</t>
                        <t t-set="url" t-value="'/my/maintenance-requests'"/>
                        <t t-set="text">View and update maintenance request progress</t>
                        <t t-set="placeholder_count" t-value="'maintenance_request_count'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ==================== Equipment List Page ==================== -->

    <template id="portal_my_equipments" name="My Equipment">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Equipment</t>
            </t>

            <t t-if="equipments" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Name</th>
                        <th>Category</th>
                        <th class="d-none d-md-table-cell">Serial No.</th>
                        <th class="d-none d-md-table-cell">Location</th>
                    </tr>
                </thead>
                <t t-foreach="equipments" t-as="equipment">
                    <tr>
                        <td>
                            <a t-attf-href="/my/equipments/#{equipment.id}">
                                <t t-esc="equipment.name"/>
                            </a>
                        </td>
                        <td>
                            <t t-if="equipment.category_id">
                                <span class="badge rounded-pill text-bg-info">
                                    <t t-esc="equipment.category_id.name"/>
                                </span>
                            </t>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <t t-if="equipment.serial_no">
                                <t t-esc="equipment.serial_no"/>
                            </t>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <t t-if="equipment.location">
                                <t t-esc="equipment.location"/>
                            </t>
                        </td>
                    </tr>
                </t>
            </t>

            <t t-if="not equipments">
                <div class="alert alert-info text-center mt-4" role="alert">
                    <i class="fa fa-inbox fa-2x mb-2 d-block"/>
                    No equipment assigned to you.
                </div>
            </t>
        </t>
    </template>

    <!-- ==================== Equipment Detail Page ==================== -->

    <template id="portal_equipment_detail" name="Equipment Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <!-- Back to list -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <a href="/my/equipments" class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-arrow-left me-1"/>Back to list
                            </a>
                        </div>

                        <!-- Equipment Info Card -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h4 class="mb-0">
                                    <i class="fa fa-cog me-2"/>
                                    <t t-esc="equipment.name"/>
                                </h4>
                            </div>
                            <div class="card-body">
                                <t t-if="equipment.serial_no">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-barcode me-1"/>Serial Number
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-esc="equipment.serial_no"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="equipment.category_id">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-tag me-1"/>Category
                                        </div>
                                        <div class="col-sm-8">
                                            <span class="badge rounded-pill text-bg-info">
                                                <t t-esc="equipment.category_id.name"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="equipment.location">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-map-marker me-1"/>Location
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-esc="equipment.location"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="equipment.model">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-cube me-1"/>Model
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-esc="equipment.model"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="equipment.assign_date">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-calendar me-1"/>Assigned Date
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-esc="equipment.assign_date" t-options='{"widget": "date"}'/>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="equipment.note">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-sticky-note me-1"/>Notes
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-raw="equipment.note"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Related Maintenance Requests -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-wrench me-2"/>Related Maintenance Requests
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-if="maintenance_requests">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="maintenance_requests" t-as="req">
                                            <a t-attf-href="/my/maintenance-requests/#{req.id}"
                                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong><t t-esc="req.name"/></strong>
                                                    <small class="text-muted ms-2">
                                                        <t t-esc="req.create_date" t-options='{"widget": "datetime", "format": "yyyy-MM-dd"}'/>
                                                    </small>
                                                </div>
                                                <span t-attf-class="badge rounded-pill #{req.stage_id.done and 'text-bg-success' or 'text-bg-info'}">
                                                    <t t-esc="req.stage_id.name"/>
                                                </span>
                                            </a>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="text-muted mb-0">No maintenance requests for this equipment.</p>
                                </t>
                            </div>
                        </div>

                        <!-- Chatter / Message Thread -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-comments me-2"/>Comments &amp; Discussion
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-call="portal.message_thread">
                                    <t t-set="object" t-value="equipment"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ==================== Maintenance Request List Page ==================== -->

    <template id="portal_my_maintenance_requests" name="My Maintenance Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Maintenance Requests</t>
            </t>

            <t t-if="requests" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Request</th>
                        <th class="d-none d-md-table-cell">Equipment</th>
                        <th class="text-center">Stage</th>
                        <th class="text-end">Date</th>
                    </tr>
                </thead>
                <t t-foreach="requests" t-as="req">
                    <tr>
                        <td>
                            <a t-attf-href="/my/maintenance-requests/#{req.id}">
                                <t t-esc="req.name"/>
                            </a>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <t t-if="req.equipment_id">
                                <t t-esc="req.sudo().equipment_id.name"/>
                            </t>
                        </td>
                        <td class="text-center">
                            <span t-attf-class="badge rounded-pill #{req.stage_id.done and 'text-bg-success' or 'text-bg-info'}">
                                <t t-esc="req.stage_id.name"/>
                            </span>
                        </td>
                        <td class="text-end">
                            <t t-esc="req.create_date" t-options='{"widget": "datetime", "format": "yyyy-MM-dd"}'/>
                        </td>
                    </tr>
                </t>
            </t>

            <t t-if="not requests">
                <div class="alert alert-info text-center mt-4" role="alert">
                    <i class="fa fa-inbox fa-2x mb-2 d-block"/>
                    No maintenance requests assigned to you.
                </div>
            </t>
        </t>
    </template>

    <!-- ==================== Maintenance Request Detail Page ==================== -->

    <template id="portal_maintenance_request_detail" name="Maintenance Request Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <!-- Back to list -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <a href="/my/maintenance-requests" class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-arrow-left me-1"/>Back to list
                            </a>
                        </div>

                        <!-- Status Progress Bar -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-tasks me-2"/>Status Progress
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between position-relative" style="overflow-x: auto;">
                                    <t t-foreach="stages" t-as="stage">
                                        <t t-set="is_active" t-value="stage.sequence &lt;= mrequest.stage_id.sequence"/>
                                        <t t-set="is_done_stage" t-value="stage.done and is_active"/>
                                        <t t-set="is_current" t-value="stage.id == mrequest.stage_id.id"/>

                                        <div class="text-center flex-fill">
                                            <div t-attf-class="rounded-circle d-inline-flex align-items-center justify-content-center #{is_done_stage and 'bg-success text-white' or (is_active and 'bg-primary text-white' or 'bg-light text-muted border')}"
                                                 style="width: 40px; height: 40px; font-size: 14px; font-weight: 600;">
                                                <t t-if="is_done_stage">
                                                    <i class="fa fa-check"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="stage_index + 1"/>
                                                </t>
                                            </div>
                                            <div t-attf-class="small mt-1 #{is_done_stage and 'text-success fw-bold' or (is_current and 'text-primary fw-bold' or 'text-muted')}">
                                                <t t-esc="stage.name"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Request Information -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h4 class="mb-0">
                                    <i class="fa fa-wrench me-2"/>
                                    <t t-esc="mrequest.name"/>
                                </h4>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4 text-muted">
                                        <i class="fa fa-file-text me-1"/>Request Name
                                    </div>
                                    <div class="col-sm-8 fw-bold">
                                        <t t-esc="mrequest.name"/>
                                    </div>
                                </div>

                                <t t-if="mrequest.sudo().equipment_id">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-cog me-1"/>Equipment
                                        </div>
                                        <div class="col-sm-8">
                                            <a t-attf-href="/my/equipments/#{mrequest.sudo().equipment_id.id}">
                                                <t t-esc="mrequest.sudo().equipment_id.name"/>
                                            </a>
                                        </div>
                                    </div>
                                </t>

                                <t t-if="mrequest.sudo().equipment_id.category_id">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-tag me-1"/>Category
                                        </div>
                                        <div class="col-sm-8">
                                            <span class="badge rounded-pill text-bg-info">
                                                <t t-esc="mrequest.sudo().equipment_id.category_id.name"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>

                                <div class="row mb-3">
                                    <div class="col-sm-4 text-muted">
                                        <i class="fa fa-wrench me-1"/>Maintenance Type
                                    </div>
                                    <div class="col-sm-8">
                                        <t t-if="mrequest.maintenance_type == 'corrective'">Corrective</t>
                                        <t t-else="">Preventive</t>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4 text-muted">
                                        <i class="fa fa-calendar me-1"/>Request Date
                                    </div>
                                    <div class="col-sm-8">
                                        <t t-esc="mrequest.request_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>

                                <t t-if="mrequest.schedule_date">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-clock-o me-1"/>Scheduled Date
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-esc="mrequest.schedule_date" t-options='{"widget": "date"}'/>
                                        </div>
                                    </div>
                                </t>

                                <div class="row mb-3">
                                    <div class="col-sm-4 text-muted">
                                        <i class="fa fa-flag me-1"/>Current Stage
                                    </div>
                                    <div class="col-sm-8">
                                        <span t-attf-class="badge rounded-pill #{mrequest.stage_id.done and 'text-bg-success' or 'text-bg-info'}">
                                            <t t-esc="mrequest.stage_id.name"/>
                                        </span>
                                    </div>
                                </div>

                                <t t-if="mrequest.description">
                                    <div class="row mb-3">
                                        <div class="col-sm-4 text-muted">
                                            <i class="fa fa-align-left me-1"/>Description
                                        </div>
                                        <div class="col-sm-8">
                                            <t t-out="mrequest.description"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Update Status -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-refresh me-2"/>Update Status
                                </h5>
                            </div>
                            <div class="card-body">
                                <form t-attf-action="/my/maintenance-requests/#{mrequest.id}/update" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <t t-if="not mrequest.stage_id.done">
                                        <t t-set="is_first_stage" t-value="mrequest.stage_id.sequence == min(stages.mapped('sequence'))"/>
                                        <t t-if="is_first_stage">
                                            <button type="submit" name="action" value="in_progress"
                                                    class="btn btn-warning btn-lg w-100">
                                                <i class="fa fa-play me-1"/>Start Work (In Progress)
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <button type="submit" name="action" value="done"
                                                    class="btn btn-success btn-lg w-100">
                                                <i class="fa fa-check me-1"/>Mark as Done
                                            </button>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-success d-flex align-items-center mb-0">
                                            <i class="fa fa-check-circle fa-lg me-2"/>
                                            This request has been completed.
                                        </div>
                                    </t>
                                </form>
                            </div>
                        </div>

                        <!-- Chatter / Message Thread -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-comments me-2"/>Comments &amp; Discussion
                                </h5>
                            </div>
                            <div class="card-body">
                                <t t-call="portal.message_thread">
                                    <t t-set="object" t-value="mrequest"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
