<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== Portal Home Card ==================== -->

    <template id="portal_my_home_maintenance" name="Portal My Home: Maintenance" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/maintenance_portal/static/src/img/maintenance_dashboard.svg?v=2'"/>
                <t t-set="title">Maintenance</t>
                <t t-set="url" t-value="'/my/maintenance'"/>
                <t t-set="text">Manage equipment and maintenance requests</t>
                <t t-set="placeholder_count" t-value="'maintenance_count'"/>
            </t>
        </div>
    </template>

    <!-- ==================== Breadcrumbs ==================== -->

    <template id="portal_breadcrumbs_maintenance" name="Portal Breadcrumbs: Maintenance"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol" position="inside">
            <!-- Maintenance Dashboard -->
            <li t-if="page_name in ('maintenance', 'equipments', 'equipment_detail', 'maintenance_requests', 'maintenance_request_detail')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'maintenance' else ''}">
                <a t-if="page_name != 'maintenance'" href="/my/maintenance">Maintenance</a>
                <t t-else="">Maintenance</t>
            </li>
            <!-- Equipment list -->
            <li t-if="page_name in ('equipments', 'equipment_detail')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'equipments' else ''}">
                <a t-if="page_name != 'equipments'" href="/my/equipments">Equipment</a>
                <t t-else="">Equipment</t>
            </li>
            <!-- Equipment detail -->
            <li t-if="page_name == 'equipment_detail'" class="breadcrumb-item active">
                <t t-esc="equipment.name"/>
            </li>
            <!-- Request list -->
            <li t-if="page_name in ('maintenance_requests', 'maintenance_request_detail')"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'maintenance_requests' else ''}">
                <a t-if="page_name != 'maintenance_requests'" href="/my/maintenance-requests">Requests</a>
                <t t-else="">Requests</t>
            </li>
            <!-- Request detail -->
            <li t-if="page_name == 'maintenance_request_detail'" class="breadcrumb-item active">
                <t t-esc="mrequest.name"/>
            </li>
        </xpath>
    </template>

    <!-- ==================== Maintenance Hub Page ==================== -->

    <template id="portal_my_maintenance" name="Maintenance Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Maintenance</t>
            </t>

            <div class="o_portal_my_home">
                <div class="o_portal_category row g-2 mt-3">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/maintenance_portal/static/src/img/equipment.svg'"/>
                        <t t-set="title">My Equipment</t>
                        <t t-set="url" t-value="'/my/equipments'"/>
                        <t t-set="text">View your assigned maintenance equipment</t>
                        <t t-set="placeholder_count" t-value="'equipment_count'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/maintenance_portal/static/src/img/maintenance_request.svg'"/>
                        <t t-set="title">Maintenance Requests</t>
                        <t t-set="url" t-value="'/my/maintenance-requests'"/>
                        <t t-set="text">View and update maintenance request progress</t>
                        <t t-set="placeholder_count" t-value="'maintenance_request_count'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ==================== Equipment List Page ==================== -->

    <template id="portal_my_equipments" name="My Equipment">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Equipment</t>
            </t>

            <t t-if="equipments">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Serial No</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="equipments" t-as="equipment">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/equipments/#{equipment.id}">
                                        <span t-esc="equipment.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-if="equipment.category_id"
                                          class="badge rounded-pill text-bg-info"
                                          t-esc="equipment.category_id.name"/>
                                </td>
                                <td>
                                    <span t-if="equipment.serial_no" t-esc="equipment.serial_no"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>

            <t t-else="">
                <div class="alert alert-warning" role="alert">
                    No equipment assigned to you.
                </div>
            </t>
        </t>
    </template>

    <!-- ==================== Equipment Detail Page ==================== -->

    <template id="portal_equipment_detail" name="Equipment Detail"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">

            <div class="row o_portal_equipment_sidebar">
                <!-- ─── Sidebar ─── -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <!-- Navigation -->
                            <div class="d-flex align-items-center flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#card_header">
                                            Equipment
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#equipment_requests">
                                            Related Requests
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#equipment_chat">
                                            History
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Category -->
                            <div t-if="equipment.category_id" class="d-flex flex-column gap-2 mt-3">
                                <h6><small class="text-muted">Category</small></h6>
                                <span class="badge rounded-pill text-bg-info"
                                      t-esc="equipment.category_id.name"/>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- ─── Main Content ─── -->
                <div id="equipment_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header" data-anchor="true">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        <i class="fa fa-cog me-1"/>
                                        <span t-esc="equipment.name"/>
                                    </h3>
                                </div>
                                <div class="col-auto" t-if="equipment.category_id">
                                    <span class="badge rounded-pill text-bg-info"
                                          t-esc="equipment.category_id.name"/>
                                </div>
                            </div>
                        </div>

                        <div id="card_body">
                            <div class="row mb-4">
                                <div class="col-12 col-md-6">
                                    <div t-if="equipment.serial_no">
                                        <strong>Serial Number:</strong> <span t-esc="equipment.serial_no"/>
                                    </div>
                                    <div t-if="equipment.location">
                                        <strong>Location:</strong> <span t-esc="equipment.location"/>
                                    </div>
                                    <div t-if="equipment.model">
                                        <strong>Model:</strong> <span t-esc="equipment.model"/>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div t-if="equipment.assign_date">
                                        <strong>Assigned Date:</strong>
                                        <span t-esc="equipment.assign_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>

                            <div t-if="equipment.note" class="mb-4">
                                <h5 class="mb-1">Notes</h5>
                                <hr class="mt-1 mb-2"/>
                                <div class="py-1 px-2 bg-100 small" t-out="equipment.note"/>
                            </div>

                            <!-- Related Maintenance Requests -->
                            <div id="equipment_requests" data-anchor="true" class="mb-4">
                                <h5 class="mb-1">Related Maintenance Requests</h5>
                                <hr class="mt-1 mb-2"/>
                                <t t-if="maintenance_requests">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Date</th>
                                                <th class="text-end">Stage</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="maintenance_requests" t-as="req">
                                                <tr>
                                                    <td>
                                                        <a t-attf-href="/my/maintenance-requests/#{req.id}">
                                                            <span t-esc="req.name"/>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <span t-esc="req.create_date" t-options='{"widget": "datetime", "format": "yyyy-MM-dd"}'/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-attf-class="badge rounded-pill #{req.stage_id.done and 'text-bg-success' or 'text-bg-warning'}"
                                                              t-esc="req.stage_id.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted mb-0">No maintenance requests for this equipment.</p>
                                </t>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <!-- Communication history / Chatter -->
                    <div id="equipment_chat" data-anchor="true">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="equipment"/>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ==================== Maintenance Request List Page ==================== -->

    <template id="portal_my_maintenance_requests" name="My Maintenance Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Maintenance Requests</t>
            </t>

            <t t-if="requests">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Equipment</th>
                            <th>Date</th>
                            <th class="text-end">Stage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="requests" t-as="req">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/maintenance-requests/#{req.id}">
                                        <span t-esc="req.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-if="req.equipment_id" t-esc="req.sudo().equipment_id.name"/>
                                </td>
                                <td>
                                    <span t-esc="req.create_date" t-options='{"widget": "datetime", "format": "yyyy-MM-dd"}'/>
                                </td>
                                <td class="text-end">
                                    <span t-attf-class="badge rounded-pill #{req.stage_id.done and 'text-bg-success' or 'text-bg-warning'}"
                                          t-esc="req.stage_id.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>

            <t t-else="">
                <div class="alert alert-warning" role="alert">
                    No maintenance requests assigned to you.
                </div>
            </t>
        </t>
    </template>

    <!-- ==================== Maintenance Request Detail Page ==================== -->

    <template id="portal_maintenance_request_detail" name="Maintenance Request Detail"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">

            <div class="row o_portal_maintenance_sidebar">
                <!-- ─── Sidebar ─── -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <!-- Navigation -->
                            <div class="d-flex align-items-center flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#card_header">
                                            Request
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#request_chat">
                                            History
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Status -->
                            <div class="d-flex flex-column gap-2 mt-3">
                                <h6><small class="text-muted">Stage</small></h6>
                                <span t-attf-class="badge rounded-pill #{mrequest.stage_id.done and 'text-bg-success' or 'text-bg-warning'}"
                                      t-esc="mrequest.stage_id.name"/>
                            </div>

                            <!-- Status Progress -->
                            <div class="d-flex flex-column gap-2">
                                <h6><small class="text-muted">Progress</small></h6>
                                <div class="d-flex flex-column gap-1">
                                    <t t-foreach="stages" t-as="stage">
                                        <t t-set="is_active" t-value="stage.sequence &lt;= mrequest.stage_id.sequence"/>
                                        <t t-set="is_done_stage" t-value="stage.done and is_active"/>
                                        <t t-set="is_current" t-value="stage.id == mrequest.stage_id.id"/>
                                        <div class="d-flex align-items-center gap-2">
                                            <i t-if="is_done_stage" class="fa fa-check-circle text-success"/>
                                            <i t-elif="is_current" class="fa fa-arrow-circle-right text-primary"/>
                                            <i t-else="" class="fa fa-circle-o text-muted"/>
                                            <small t-attf-class="#{is_current and 'fw-bold' or (is_done_stage and 'text-success' or 'text-muted')}"
                                                   t-esc="stage.name"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Update Status Action -->
                            <div class="d-flex flex-column gap-2">
                                <form t-attf-action="/my/maintenance-requests/#{mrequest.id}/update" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <t t-if="not mrequest.stage_id.done">
                                        <t t-set="is_first_stage" t-value="mrequest.stage_id.sequence == min(stages.mapped('sequence'))"/>
                                        <t t-if="is_first_stage">
                                            <button type="submit" name="action" value="in_progress"
                                                    class="btn btn-primary btn-sm w-100">
                                                <i class="fa fa-play me-1"/>Start Work
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <button type="submit" name="action" value="done"
                                                    class="btn btn-success btn-sm w-100">
                                                <i class="fa fa-check me-1"/>Mark as Done
                                            </button>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <span class="text-success">
                                            <i class="fa fa-check-circle me-1"/>Completed
                                        </span>
                                    </t>
                                </form>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- ─── Main Content ─── -->
                <div id="request_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header" data-anchor="true">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        <i class="fa fa-wrench me-1"/>
                                        <span t-esc="mrequest.name"/>
                                    </h3>
                                </div>
                                <div class="col-auto">
                                    <small class="text-end">Stage:</small>
                                    <span t-attf-class="badge rounded-pill #{mrequest.stage_id.done and 'text-bg-success' or 'text-bg-warning'}"
                                          t-esc="mrequest.stage_id.name"/>
                                </div>
                            </div>
                        </div>

                        <div id="card_body">
                            <div class="row mb-4">
                                <div class="col-12 col-md-6">
                                    <div t-if="mrequest.sudo().equipment_id">
                                        <strong>Equipment:</strong>
                                        <a t-attf-href="/my/equipments/#{mrequest.sudo().equipment_id.id}"
                                           t-esc="mrequest.sudo().equipment_id.name"/>
                                    </div>
                                    <div t-if="mrequest.sudo().equipment_id.category_id">
                                        <strong>Category:</strong>
                                        <span class="badge rounded-pill text-bg-info"
                                              t-esc="mrequest.sudo().equipment_id.category_id.name"/>
                                    </div>
                                    <div>
                                        <strong>Maintenance Type:</strong>
                                        <t t-if="mrequest.maintenance_type == 'corrective'">Corrective</t>
                                        <t t-else="">Preventive</t>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div>
                                        <strong>Request Date:</strong>
                                        <span t-esc="mrequest.request_date" t-options='{"widget": "date"}'/>
                                    </div>
                                    <div t-if="mrequest.schedule_date">
                                        <strong>Scheduled Date:</strong>
                                        <span t-esc="mrequest.schedule_date" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                            </div>

                            <div t-if="mrequest.description" class="mb-4">
                                <h5 class="mb-1">Description</h5>
                                <hr class="mt-1 mb-2"/>
                                <div class="py-1 px-2 bg-100 small" t-out="mrequest.description"/>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <!-- Communication history / Chatter -->
                    <div id="request_chat" data-anchor="true">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="mrequest"/>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
